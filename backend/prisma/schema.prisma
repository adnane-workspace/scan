generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  superadmin
}

enum ActivityAction {
  cafe_created
  cafe_activated
  cafe_deactivated
  cafe_password_reset
  cafe_updated
  auth_login
  auth_login_failed
  auth_password_changed
  product_created
  product_updated
  product_deleted
  product_availability
  category_created
  category_updated
  category_deleted
}

model Cafe {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(120)
  description String        @default("") @db.VarChar(500)
  logo        String        @default("")
  address     String        @default("") @db.VarChar(200)
  phone       String        @default("") @db.VarChar(30)
  latitude    Float?
  longitude   Float?
  slug        String        @unique @db.VarChar(80)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       User[]
  categories  Category[]
  products    Product[]
  activityLogs ActivityLog[]
}

model User {
  id             String          @id @default(uuid())
  name           String          @db.VarChar(80)
  email          String          @unique @db.VarChar(160)
  passwordHash   String
  role           UserRole        @default(admin)
  cafeId         String?
  cafe           Cafe?           @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  activityLogs   ActivityLog[]
  passwordResets PasswordReset[]
}

model PasswordReset {
  id         String    @id @default(uuid())
  email      String    @db.VarChar(160)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model ActivityLog {
  id        String         @id @default(uuid())
  action    ActivityAction
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  cafeId    String?
  cafe      Cafe?    @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([cafeId])
}

model Category {
  id          String    @id @default(uuid())
  cafeId      String
  cafe        Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(80)
  description String    @default("") @db.VarChar(300)
  image       String    @default("")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([cafeId, order])
}

model Product {
  id          String   @id @default(uuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  price       Decimal  @db.Decimal(10, 2)
  image       String   @default("")
  available   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cafeId, categoryId, order])
}
