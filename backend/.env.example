PORT=5000
NODE_ENV=development

# Local Postgres (default)
# DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/digital-menu
# DIRECT_URL=postgresql://postgres:root@127.0.0.1:5432/digital-menu

# Neon (recommended for local dev — create a free "dev" branch in the Neon console)
# 1. https://console.neon.tech → your project → Connection details
# 2. DATABASE_URL = "Pooled connection" (host ends with -pooler)
# 3. DIRECT_URL   = "Direct connection" (same host without -pooler)
# Always add ?sslmode=require at the end of both URLs.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-min-16-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
ROOT_DOMAIN=scanosh.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Resend (recommandé en prod)
# 1. https://resend.com → API Keys → créer une clé
# 2. Domains → ajouter scanosh.com → copier les enregistrements DNS dans Cloudflare
# 3. Une fois le domaine vérifié, utiliser contact@scanosh.com comme expéditeur
RESEND_API_KEY=
MAIL_FROM=Scanosh <contact@scanosh.com> (ignoré si RESEND_API_KEY est défini)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
